  "citations": [
    {
      "id": "tn-2103-i-18",
      "source": "TN-S1",
      "pinpoint": "I(18)",
      "quote": "Students shall complete three (3) credits in an elective focus."
    },
    {
      "id": "tn-2103-i-18a",
      "source": "TN-S1",
      "pinpoint": "I(18)(a)",
      "quote": "The elective focus may be CTE, science and math, humanities, fine arts, AP/IB, Cambridge, computer science or other areas approved by the local board of education."
    },
    {
      "id": "tn-2103-i-18a-cte",
      "source": "TN-S1",
      "pinpoint": "I(18)(a)",
      "quote": "Students completing a CTE elective focus shall complete three (3) credits in the same CTE career cluster or state- approved program of study."
    },
    {
      "id": "tn-2103-iii-hsbp-focus",
      "source": "TN-S1",
      "pinpoint": "III(d)",
      "quote": "Select an elective focus and plan courses accordingly by the end of grade ten (10);"
    },
    {
      "id": "tn-3103-i-4b",
      "source": "TN-S3",
      "pinpoint": "I(4)(b)",
      "quote": "A course used to substitute for a graduation requirement course may also fulfill the requirements toward the student’s elective focus"
    }
  ],
