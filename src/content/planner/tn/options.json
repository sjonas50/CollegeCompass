    {
      "id": "tn.focus.cte",
      "state": "TN",
      "kind": "graduation_option",
      "title": "Elective focus: Career and technical education",
      "issuer": { "kind": "state", "name": "Tennessee" },
      "plainSummary": "Your elective focus is 3 credits on top of your other requirements. This one is career and technical education. Choose your focus by the end of 10th grade; you can change it with your counselor.",
      "strength": "required",
      "strengthCite": "tn-2103-i-18",
      "confidence": "verified",
      "cohortKey": "grade9_entry_year",
      "projectedBeyond": 2026,
      "appliesWhen": { "choice": { "key": "tnElectiveFocus", "value": "cte" } },
      "variants": [
        {
          "id": "tn.focus.cte.2023",
          "cohort": { "to": 2023 },
          "extends": "tn.grad.2023",
          "allocation": "exclusive",
          "requirements": [
            {
              "id": "focus",
              "label": "3 credits in one career and technical program",
              "kind": "credits",
              "units": 12,
              "select": [{ "cte": true }],
              "cite": ["tn-2103-i-18", "tn-2103-i-18a", "tn-2103-i-18a-cte"],
              "note": "All three credits must be in the same career cluster or state program of study.",
              "area": "electives"
            }
          ],
          "warnings": [
            {
              "id": "focus.by-10",
              "text": "Choose your elective focus by the end of 10th grade.",
              "cite": ["tn-2103-iii-hsbp-focus"]
            },
            {
              "id": "focus.substitutes",
              "text": "A class that stands in for another requirement can also count toward your focus.",
              "cite": ["tn-3103-i-4b"]
            }
          ],
          "unverified": [
            {
              "id": "focus.list",
              "text": "We couldn't confirm Tennessee's list of career and technical programs of study. Your school's own list decides which classes go together."
            }
          ]
        },
