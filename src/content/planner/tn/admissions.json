      "id": "tn-ttu-tests",
      "source": "TN-S22",
      "quote": "If submitted, test scores such as the ACT and SAT will be considered."
    },
    {
      "id": "tn-utc-must-meet",
      "source": "TN-S13",
      "quote": "First-time freshmen must meet unit requirements with completed high school courses."
    },
    {
      "id": "tn-utc-tests",
      "source": "TN-S13",
      "quote": "All applicants are required to submit ACT/SAT scores, regardless of class rank or GPA."
    },
    {
      "id": "tn-utc-units-1",
      "source": "TN-S13",
      "quote": "4 units of English 4 units of math (algebra I and II, geometry and 1 additional unit) 3 units of lab science 1 unit of European history, world history, or world geography"
    },
    {
      "id": "tn-utc-units-2",
      "source": "TN-S13",
      "quote": "2 units of the same foreign language (Sign Language courses included) 1 unit of visual or performing art 1 unit of American history"
    },
    {
      "id": "tn-utk-core-list",
      "source": "TN-S8",
      "pinpoint": "Core Academic Subjects",
      "quote": "4 English 4 Math (algebra, geometry, trigonometry, calculus, statistics, or other advanced math) 3 Science (biology, chemistry, physics, or other science) 1 American history 1 European history, world history, or world geography 2 Single foreign language (or ASL) 1 Visual or performing arts"
    },
    {
      "id": "tn-utk-core-strongly-encouraged",
      "source": "TN-S8",
      "pinpoint": "How does UT calculate my UT Core GPA?",
      "quote": "Completion of all sixteen core courses is not required for admission but strongly encouraged."
    },
    {
      "id": "tn-utk-core-weights",
      "source": "TN-S8",
      "pinpoint": "How does UT calculate my UT Core GPA?",
      "quote": "your GPA will be weighted by UT to reflect honors courses (0.5 quality points added), Advanced Placement (AP), Cambridge AS and A Level, International Baccalaureate (IB), and dual enrollment courses (1.0 quality points added)."
    },
    {
      "id": "tn-utk-guarantee",
      "source": "TN-S8",
      "quote": "Score a 24+ ACT composite (SAT 1160+) with both a 19+ Math ACT subscore (510+ SAT Math) AND 19+ English ACT subscore (500+ SAT (ER + W)) AND"
    },
    {
      "id": "tn-utk-guarantee-update",
      "source": "TN-S8",
      "pinpoint": "Guaranteed Admission FAQs",
      "quote": "We are aware of the policy updates passed by the UT Board of Trustees on Tuesday, June 25. Our team is working on updates and will provide information and guidance soon."
    },
    {
      "id": "tn-utk-holistic",
      "source": "TN-S8",
      "pinpoint": "What is holistic review?",
      "quote": "Rigor of your high school curriculum Difficulty of senior-level coursework"
    },
    {
      "id": "tn-utk-tests",
      "source": "TN-S8",
      "quote": "Yes, all applicants are required to provide standardized test scores on their application per UT’s test score policy."
    },
    {
      "id": "tn-utm-must-meet",
      "source": "TN-S15",
      "quote": "First-year students must meet unit requirements with completed high school courses."
    },
    {
      "id": "tn-utm-tests",
      "source": "TN-S15",
      "quote": "All ACT and SAT scores are super-scored when multiple tests are submitted. All applicants are required to submit ACT/SAT scores, regardless of class rank or GPA."
    },
    {
      "id": "tn-utm-units-1",
      "source": "TN-S15",
      "quote": "English: 4 units Algebra: 2 units Advanced Math: 2 unit of geometry, trigonometry, calculus or advanced mathematics U.S. History: 1 unit Social Studies: 1 unit of world history, European history, or world geography (may be fulfilled by completing 2 one-half unit courses)"
    },
    {
      "id": "tn-utm-units-2",
      "source": "TN-S15",
      "quote": "Science: 3 units, including biology, chemistry or physics, and a third lab course Foreign Language: 2 units in the same language Visual/Performing Arts: 1 unit of theater arts, visual arts, music theory, music history, vocal music, instrumental music or art history"
    },
    {
      "id": "tn-uts-criteria",
      "source": "TN-S16",
      "quote": "Criteria 1 – A student must have a composite score of 17 or above on the American College Test (ACT) or a 920 SAT (ERW+M) and a cumulative high school grade point average of 3.0 or above on a 4.0 scale."
    }
