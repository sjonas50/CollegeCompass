    {
      "id": "ut-r277-700-6-12-acgc",
      "source": "UT-S1",
      "pinpoint": "R277-700-6(12)(a)(v)",
      "quote": "(v) Beginning with incoming 10th graders in the 2026-2027 school year, the requirement in Subsection (iv) will be replaced by American Constitutional Government and Citizenship (1.0 units of credit);"
    },
    {
      "id": "ut-r277-700-6-15",
      "source": "UT-S1",
      "pinpoint": "R277-700-6(15)(a)",
      "quote": "Physical Education (1.5 units of credit from each of the following): (i) Participation Skills (0.5 units of credit); (ii) Fitness for Life (0.5 units of credit); and (iii) Individualized Lifetime Activities (0.5 units of credit);"
    },
    {
      "id": "ut-r277-700-6-6",
      "source": "UT-S1",
      "pinpoint": "R277-700-6(6)",
      "quote": "Mathematics (3.0 units of credit) shall be met minimally through successful completion of a combination of the foundation or foundation extended courses, Secondary Mathematics I, Secondary Mathematics II, and Secondary Mathematics III."
    },
    {
      "id": "ut-ssfaq-acgc-available",
      "source": "UT-S4",
      "pinpoint": "p. 1",
      "quote": "American Constitutional Government and Citizenship will be available to students in the 2027-2028 school year."
    },
    {
      "id": "ut-usbe-2627-digital",
      "source": "UT-S3",
      "pinpoint": "p. 6",
      "quote": "The six approved courses that count towards the Digital Studies 0.5 required graduation credit are: Business Office Specialist Digital Business Apps Computer Programming 1 Exploring Computer Science Computer Science Principles Web Development 1"
    },
    {
      "id": "ut-usbe-2627-gfl",
      "source": "UT-S3",
      "pinpoint": "p. 7",
      "quote": "The 0.5 credit for General Financial Literacy can be met through the following courses: General Financial Literacy or Finance CE"
    },
    {
      "id": "ut-usbe-2627-health",
      "source": "UT-S3",
      "pinpoint": "p. 6",
      "quote": "Health Education 0.5 credits Health II"
    },
    {
      "id": "ut-usbe-2627-la",
      "source": "UT-S3",
      "pinpoint": "p. 2",
      "quote": "Three courses from the foundational courses plus one course from the Level 12 course options or the Applied and Advanced List"
    },
    {
      "id": "ut-usbe-2627-la10",
      "source": "UT-S3",
      "pinpoint": "p. 2",
      "quote": "Language Arts Level 10 (1.0 Credit) ELA 10 AP Seminar"
    },
    {
      "id": "ut-usbe-2627-la11",
      "source": "UT-S3",
      "pinpoint": "p. 2",
      "quote": "Language Arts Level 11 (1.0 Credit) English 11 English 11 Honors International Baccalaureate AP Literature & Composition AP Language & Composition"
    },
    {
      "id": "ut-usbe-2627-la12",
      "source": "UT-S3",
      "pinpoint": "p. 2",
      "quote": "Language Arts Level 12 (1.0 Credit) English 12 English Concurrent Enrollment* International Baccalaureate AP Literature & Composition AP Language & Composition"
    },
    {
      "id": "ut-usbe-2627-math-advanced",
      "source": "UT-S3",
      "pinpoint": "p. 3",
      "quote": "Advanced Courses (Secondary III Pre-requisite) AP Calculus AB or BC AP Statistics AP Pre-Calculus College Prep Math Concurrent Enrollment* 1010, 1030, 1040, 1050, or 1060 International Baccalaureate Introductory Calculus"
    },
    {
      "id": "ut-usbe-2627-sci",
      "source": "UT-S3",
      "pinpoint": "p. 4",
      "quote": "A total of two courses from two of the five areas of science on the Foundational Courses list plus one credit from the Foundation Courses list or Applied and Advanced Courses list."
    },
