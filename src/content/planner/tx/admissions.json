          "cohort": {  },
          "allocation": "independent",
          "requirements": [
            {
              "id": "calculus",
              "label": "Calculus I with a B or higher, graded by December 10 of 12th grade",
              "kind": "credits",
              "units": 4,
              "select": [{ "types": ["math.calc", "math.calc2"], "minLetter": "B" }],
              "cite": ["tx-ut-calc-course", "tx-ut-calc-college", "tx-ut-calc-deadline", "tx-ut-faq-december-10"],
              "area": "math",
              "deadlineGrade": 11,
              "note": "The class route usually means finishing Calculus I in 11th grade. A 12th-grade class counts only if its final grade is on your transcript by December 10; ask your counselor."
