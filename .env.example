# Copy to .env.local for development. Everything is optional locally.

# Postgres. Leave unset to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/college_compass

APP_URL=http://localhost:3000

# Verifiable parental consent method. Only "dev_attestation" exists and it is refused in production.
CONSENT_VERIFIER=dev_attestation
CONSENT_REQUEST_TTL_DAYS=7

# "log" prints emails to the console (development only).
EMAIL_TRANSPORT=log
# In production, an address on the domain you verified in Resend.
EMAIL_FROM="College Compass <no-reply@localhost>"

# Protects /api/cron/sweep (required in production; Vercel Cron sends it automatically).
# CRON_SECRET=

# AI. Without a key, safety screening falls back to the rules tier only.
# ANTHROPIC_API_KEY=
AI_MODEL_SAFETY=claude-opus-5
# Tried if the primary safety model errors, before falling back to keyword rules alone.
AI_MODEL_SAFETY_BACKUP=claude-sonnet-5
AI_MODEL_COUNSELOR=claude-opus-5
AI_MONTHLY_BUDGET_USD=3

# Optional: a free key from https://api.data.gov/signup/ for `npm run data:check-scorecard`
# (compares our college data with the live College Scorecard). DEMO_KEY is used without it.
# SCORECARD_API_KEY=

# Access and billing. Without Stripe keys, paid checkout is off (trial and free access still work).
# TRIAL_DAYS=14
# FREE_ACCESS_MONTHS=12
# STRIPE_SECRET_KEY=
# Locally, the whsec_ value `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints;
# in production, the signing secret of the webhook endpoint in Stripe's dashboard.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_ANNUAL=

# Email through Resend (set EMAIL_TRANSPORT=resend).
# RESEND_API_KEY=
